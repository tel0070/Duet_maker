# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Environment and secrets
.env
.env.local
.env.*.local

# Test / coverage output
coverage/
playwright-report/
test-results/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*

# Local engine (Python)
local-engine/.venv/
local-engine/__pycache__/
local-engine/**/__pycache__/
local-engine/.pytest_cache/
# apps/web's build output, copied here only by build-local-engine-exe.yml
local-engine/static/
*.pyc

# User project data / uploaded audio (never committed)
examples/**/*.wav
examples/**/*.mp3
!examples/**/*.example.wav

# Model weights (downloaded via scripts, not committed)
**/models/*.onnx
**/models/*.bin

# Synced from examples/demo-projects/ by scripts/sync-samples.mjs
# (predev/prebuild) — examples/ is the single source of truth.
apps/web/public/samples/
