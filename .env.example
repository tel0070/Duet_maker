# Duet Maker does not require any secrets, API keys, or accounts for core
# features. Everything in apps/web and packages/harmony-core runs entirely in
# the browser. This file exists only for optional, non-sensitive build-time
# configuration.

# Base path the web app is served from (used by Vite `base`).
# Leave as "/" for a custom domain, or "/duet_maker/" for a
# https://<user>.github.io/duet_maker/ style GitHub Pages deployment.
VITE_BASE_PATH=/

# Public production URL, used only for Open Graph / sitemap metadata.
VITE_PUBLIC_SITE_URL=https://tel0070.github.io/duet_maker/

# Optional: local-engine's URL (Phase 5, see local-engine/README.md). Only
# needed if you run local-engine on a non-default host/port; the app
# defaults to http://127.0.0.1:8000 without this set. local-engine itself
# needs no secrets either — everything stays on localhost.
VITE_LOCAL_ENGINE_URL=http://127.0.0.1:8000
